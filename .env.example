# Starfish Nifty 50 Dashboard - Environment Variables

# Database Configuration
DB_USER=starfish
DB_PASSWORD=starfish
DB_NAME=starfish
DB_URL=postgresql://starfish:starfish@localhost:5432/starfish

# API Configuration
API_URL=http://localhost:8000

# NSE API (for backfill)
NSE_BASE_URL=https://www.nseindia.com
# Add session cookies if needed for authenticated requests

# Notification Settings (for Phase I - deferred)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Logging
LOG_LEVEL=INFO